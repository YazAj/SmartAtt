@model IReadOnlyList<LectureScheduleDto>
@{
    ViewData["Title"] = Localizer["SectionTimetable"];
    var sections = (IReadOnlyList<LookupItem>)(ViewBag.Sections ?? Array.Empty<LookupItem>());
    var selectedSectionId = ViewBag.SectionId?.ToString() ?? string.Empty;
}
<section class="page-header"><div><p class="eyebrow">@Localizer["LectureSchedulesTitle"]</p><h1>@Localizer["SectionTimetable"]</h1><p>@Localizer["TimetableDescription"]</p></div><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></section>
<section class="app-panel"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="sectionId">@Localizer["Section"]</label><select id="sectionId" name="sectionId" class="form-select"><option value="">@Localizer["SelectSection"]</option>@foreach (var item in sections) { <option value="@item.Value" selected="@(selectedSectionId == item.Value)">@item.Text</option> }</select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["ViewTimetable"]</button></div></form></section>
<section class="app-panel mt-3"><div class="timetable-grid">
@foreach (var day in Enum.GetValues<DayOfWeek>())
{
    var dayItems = Model.Where(item => item.DayOfWeek == day).OrderBy(item => item.StartTime).ToList();
    <article class="timetable-day"><h2>@Localizer[$"DayOfWeek{day}"]</h2>@if (dayItems.Count == 0) { <p class="empty-row">@Localizer["NoScheduledLectures"]</p> } else { foreach (var schedule in dayItems) { <div class="timetable-item"><strong>@schedule.StartTime.ToString("HH:mm") - @schedule.EndTime.ToString("HH:mm")</strong><span>@schedule.CourseCode - @schedule.SectionNumber</span><small>@schedule.ClassroomCode / @schedule.InstructorNameEnglish</small></div> } }</article>
}
</div></section>
