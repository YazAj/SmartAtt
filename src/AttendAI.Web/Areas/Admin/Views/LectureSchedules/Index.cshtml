@model PagedResult<LectureScheduleDto>
@{
    ViewData["Title"] = Localizer["LectureSchedulesTitle"];
    var search = Context.Request.Query["Search"].ToString();
    var active = Context.Request.Query["IsActive"].ToString();
    var sections = (IReadOnlyList<LookupItem>)(ViewBag.Sections ?? Array.Empty<LookupItem>());
    var instructors = (IReadOnlyList<LookupItem>)(ViewBag.Instructors ?? Array.Empty<LookupItem>());
    var classrooms = (IReadOnlyList<LookupItem>)(ViewBag.Classrooms ?? Array.Empty<LookupItem>());
}
<section class="page-header"><div><p class="eyebrow">@Localizer["NavLectureManagement"]</p><h1>@Localizer["LectureSchedulesTitle"]</h1><p>@Localizer["LectureSchedulesDescription"]</p></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="ClassroomTimetable">@Localizer["ClassroomTimetable"]</a><a class="btn btn-secondary app-btn" asp-action="SectionTimetable">@Localizer["SectionTimetable"]</a><a class="btn btn-primary app-btn" asp-action="Create">@Localizer["CreateLectureSchedule"]</a></div></section>
<section class="app-panel"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchLectureSchedulesPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="SectionId">@Localizer["Section"]</label><select id="SectionId" name="SectionId" class="form-select"><option value="">@Localizer["AllSections"]</option>@foreach (var item in sections) { <option value="@item.Value" selected="@(Context.Request.Query["SectionId"] == item.Value)">@item.Text</option> }</select></div><div class="form-field"><label class="form-label" for="InstructorId">@Localizer["Instructor"]</label><select id="InstructorId" name="InstructorId" class="form-select"><option value="">@Localizer["AllInstructors"]</option>@foreach (var item in instructors) { <option value="@item.Value" selected="@(Context.Request.Query["InstructorId"] == item.Value)">@item.Text</option> }</select></div><div class="form-field"><label class="form-label" for="ClassroomId">@Localizer["Classroom"]</label><select id="ClassroomId" name="ClassroomId" class="form-select"><option value="">@Localizer["AllClassrooms"]</option>@foreach (var item in classrooms) { <option value="@item.Value" selected="@(Context.Request.Query["ClassroomId"] == item.Value)">@item.Text</option> }</select></div><div class="form-field"><label class="form-label" for="DayOfWeek">@Localizer["Day"]</label><select id="DayOfWeek" name="DayOfWeek" class="form-select"><option value="">@Localizer["AllDays"]</option>@foreach (var day in Enum.GetValues<DayOfWeek>()) { <option value="@day" selected="@(Context.Request.Query["DayOfWeek"] == day.ToString())">@Localizer[$"DayOfWeek{day}"]</option> }</select></div><div class="form-field"><label class="form-label" for="IsActive">@Localizer["Status"]</label><select id="IsActive" name="IsActive" class="form-select"><option value="">@Localizer["AllStatuses"]</option><option value="true" selected="@(active == "true")">@Localizer["Active"]</option><option value="false" selected="@(active == "false")">@Localizer["Inactive"]</option></select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["Course"]</th><th>@Localizer["Instructor"]</th><th>@Localizer["Classroom"]</th><th>@Localizer["ScheduleWindow"]</th><th>@Localizer["Defaults"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="7">@Localizer["NoLectureSchedules"]</td></tr> }
@foreach (var schedule in Model.Items) { <tr><td data-label="@Localizer["Course"]">@schedule.CourseCode - @schedule.SectionNumber<br /><small>@schedule.CourseNameEnglish / @schedule.CourseNameArabic</small></td><td data-label="@Localizer["Instructor"]">@schedule.EmployeeNumber<br /><small>@schedule.InstructorNameEnglish / @schedule.InstructorNameArabic</small></td><td data-label="@Localizer["Classroom"]">@schedule.ClassroomCode</td><td data-label="@Localizer["ScheduleWindow"]">@Localizer[$"DayOfWeek{schedule.DayOfWeek}"] @schedule.StartTime.ToString("HH:mm") - @schedule.EndTime.ToString("HH:mm")<br /><small>@schedule.EffectiveFrom - @schedule.EffectiveTo</small></td><td data-label="@Localizer["Defaults"]">@Localizer["LateMinutesShort", schedule.DefaultLateThresholdMinutes]<br /><small>@Localizer["RadiusMetersShort", schedule.DefaultAllowedRadiusMeters]</small></td><td data-label="@Localizer["Status"]"><span class="status-badge @(schedule.IsActive ? "status-badge-success" : "status-badge-warning")">@(schedule.IsActive ? Localizer["Active"] : Localizer["Inactive"])</span></td><td data-label="@Localizer["Actions"]"><div class="row-actions"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@schedule.Id">@Localizer["Details"]</a><a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@schedule.Id">@Localizer["Edit"]</a><form asp-action="@(schedule.IsActive ? "Deactivate" : "Activate")" asp-route-id="@schedule.Id" method="post" onsubmit="return confirm('@Localizer["ConfirmStatusChange"]');"><button class="btn btn-sm @(schedule.IsActive ? "btn-danger" : "btn-primary")" type="submit">@(schedule.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])</button></form></div></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-IsActive="@active" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-IsActive="@active" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
