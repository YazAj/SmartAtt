@model LectureScheduleCommand
@{
    var sections = (IReadOnlyList<LookupItem>)(ViewBag.Sections ?? Array.Empty<LookupItem>());
    var instructors = (IReadOnlyList<LookupItem>)(ViewBag.Instructors ?? Array.Empty<LookupItem>());
    var classrooms = (IReadOnlyList<LookupItem>)(ViewBag.Classrooms ?? Array.Empty<LookupItem>());
}
<section class="app-panel form-panel"><form method="post" class="app-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="RowVersion" type="hidden" /><div class="form-grid">
<div class="form-field"><label asp-for="SectionId" class="form-label field-required">@Localizer["Section"]</label><select asp-for="SectionId" class="form-select"><option value="">@Localizer["SelectSection"]</option>@foreach (var item in sections) { <option value="@item.Value">@item.Text</option> }</select><span asp-validation-for="SectionId" class="validation-message"></span></div>
<div class="form-field"><label asp-for="InstructorId" class="form-label field-required">@Localizer["Instructor"]</label><select asp-for="InstructorId" class="form-select"><option value="">@Localizer["SelectInstructor"]</option>@foreach (var item in instructors) { <option value="@item.Value">@item.Text</option> }</select><span asp-validation-for="InstructorId" class="validation-message"></span></div>
<div class="form-field"><label asp-for="ClassroomId" class="form-label field-required">@Localizer["Classroom"]</label><select asp-for="ClassroomId" class="form-select"><option value="">@Localizer["SelectClassroom"]</option>@foreach (var item in classrooms) { <option value="@item.Value">@item.Text</option> }</select><span asp-validation-for="ClassroomId" class="validation-message"></span></div>
<div class="form-field"><label asp-for="DayOfWeek" class="form-label field-required">@Localizer["Day"]</label><select asp-for="DayOfWeek" class="form-select">@foreach (var day in Enum.GetValues<DayOfWeek>()) { <option value="@day">@Localizer[$"DayOfWeek{day}"]</option> }</select><span asp-validation-for="DayOfWeek" class="validation-message"></span></div>
<div class="form-field"><label asp-for="StartTime" class="form-label field-required">@Localizer["StartTime"]</label><input asp-for="StartTime" type="time" class="form-control" /><span asp-validation-for="StartTime" class="validation-message"></span></div>
<div class="form-field"><label asp-for="EndTime" class="form-label field-required">@Localizer["EndTime"]</label><input asp-for="EndTime" type="time" class="form-control" /><span asp-validation-for="EndTime" class="validation-message"></span></div>
<div class="form-field"><label asp-for="EffectiveFrom" class="form-label field-required">@Localizer["EffectiveFrom"]</label><input asp-for="EffectiveFrom" type="date" class="form-control" /><span asp-validation-for="EffectiveFrom" class="validation-message"></span></div>
<div class="form-field"><label asp-for="EffectiveTo" class="form-label field-required">@Localizer["EffectiveTo"]</label><input asp-for="EffectiveTo" type="date" class="form-control" /><span asp-validation-for="EffectiveTo" class="validation-message"></span></div>
<div class="form-field"><label asp-for="DefaultLateThresholdMinutes" class="form-label field-required">@Localizer["LateThresholdMinutes"]</label><input asp-for="DefaultLateThresholdMinutes" type="number" min="0" class="form-control" /><span asp-validation-for="DefaultLateThresholdMinutes" class="validation-message"></span></div>
<div class="form-field"><label asp-for="DefaultAllowedRadiusMeters" class="form-label field-required">@Localizer["AllowedRadiusMeters"]</label><input asp-for="DefaultAllowedRadiusMeters" type="number" min="0" class="form-control" /><span asp-validation-for="DefaultAllowedRadiusMeters" class="validation-message"></span></div>
</div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["SaveChanges"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
