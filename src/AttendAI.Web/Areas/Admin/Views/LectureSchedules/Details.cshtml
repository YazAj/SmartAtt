@model LectureScheduleDto
@{ ViewData["Title"] = Localizer["LectureScheduleDetails"]; }
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["LectureSchedulesTitle"]</p><h1 class="lecture-identifier-title"><span>@Model.CourseCode</span><span class="lecture-title-divider"> - </span><span>@Model.SectionNumber</span></h1><small>@Localizer[$"DayOfWeek{Model.DayOfWeek}"] @Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Edit" asp-route-id="@Model.Id">@Localizer["Edit"]</a><a class="btn btn-secondary app-btn" asp-action="SectionTimetable" asp-route-sectionId="@Model.SectionId">@Localizer["SectionTimetable"]</a><a class="btn btn-secondary app-btn" asp-action="ClassroomTimetable" asp-route-classroomId="@Model.ClassroomId">@Localizer["ClassroomTimetable"]</a><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Course"]</span><div class="detail-value">@Model.CourseCode - @Model.CourseNameEnglish / @Model.CourseNameArabic</div></div><div><span class="detail-label">@Localizer["Section"]</span><div class="detail-value">@Model.SectionNumber</div></div><div><span class="detail-label">@Localizer["Instructor"]</span><div class="detail-value">@Model.EmployeeNumber - @Model.InstructorNameEnglish / @Model.InstructorNameArabic</div></div><div><span class="detail-label">@Localizer["Classroom"]</span><div class="detail-value">@Model.ClassroomLabelEnglish<br />@Model.ClassroomLabelArabic</div></div><div><span class="detail-label">@Localizer["EffectiveRange"]</span><div class="detail-value">@Model.EffectiveFrom - @Model.EffectiveTo</div></div><div><span class="detail-label">@Localizer["ScheduleWindow"]</span><div class="detail-value">@Localizer[$"DayOfWeek{Model.DayOfWeek}"] @Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</div></div><div><span class="detail-label">@Localizer["LateThresholdMinutes"]</span><div class="detail-value">@Model.DefaultLateThresholdMinutes</div></div><div><span class="detail-label">@Localizer["AllowedRadiusMeters"]</span><div class="detail-value">@Model.DefaultAllowedRadiusMeters</div></div><div><span class="detail-label">@Localizer["Status"]</span><div class="detail-value">@(Model.IsActive ? Localizer["Active"] : Localizer["Inactive"])</div></div></div></section>
