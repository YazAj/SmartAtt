@model InstructorAssignmentCommand
@{ ViewData["Title"] = Localizer["CreateAssignment"]; var instructors = (IReadOnlyList<LookupItem>)(ViewBag.Instructors ?? Array.Empty<LookupItem>()); var sections = (IReadOnlyList<LookupItem>)(ViewBag.Sections ?? Array.Empty<LookupItem>()); }
<section class="page-header"><div><p class="eyebrow">@Localizer["InstructorAssignmentsTitle"]</p><h1>@Localizer["CreateAssignment"]</h1><p>@Localizer["AssignmentFormDescription"]</p></div></section>
<section class="app-panel form-panel"><form method="post" class="app-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="form-field"><label asp-for="InstructorId" class="form-label field-required">@Localizer["Instructor"]</label><select asp-for="InstructorId" class="form-select"><option value="">@Localizer["SelectInstructor"]</option>@foreach (var item in instructors) { <option value="@item.Value">@item.Text</option> }</select></div><div class="form-field"><label asp-for="SectionId" class="form-label field-required">@Localizer["Section"]</label><select asp-for="SectionId" class="form-select"><option value="">@Localizer["SelectSection"]</option>@foreach (var item in sections) { <option value="@item.Value">@item.Text</option> }</select></div><div class="form-check app-check"><input asp-for="IsPrimary" class="form-check-input" /><label asp-for="IsPrimary" class="form-check-label">@Localizer["PrimaryInstructor"]</label></div></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["CreateAssignment"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
