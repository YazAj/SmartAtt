@model InstructorAssignmentDto
@{ ViewData["Title"] = Localizer["AssignmentDetails"]; }
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["InstructorAssignmentsTitle"]</p><h1>@Model.EmployeeNumber</h1><small>@Model.SectionLabel</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="SetPrimary" asp-route-id="@Model.Id">@Localizer["SetPrimary"]</a><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Instructor"]</span><div class="detail-value">@Model.InstructorNameEnglish / @Model.InstructorNameArabic</div></div><div><span class="detail-label">@Localizer["Course"]</span><div class="detail-value">@Model.CourseCode - @Model.CourseNameEnglish / @Model.CourseNameArabic</div></div><div><span class="detail-label">@Localizer["Section"]</span><div class="detail-value">@Model.SectionLabel</div></div><div><span class="detail-label">@Localizer["PrimaryInstructor"]</span><div class="detail-value">@(Model.IsPrimary ? Localizer["Yes"] : Localizer["No"])</div></div><div><span class="detail-label">@Localizer["AssignedAtUtc"]</span><div class="detail-value">@Model.AssignedAtUtc.ToString("u")</div></div></div></section>
