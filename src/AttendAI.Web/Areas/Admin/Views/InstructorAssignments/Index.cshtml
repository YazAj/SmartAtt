@model PagedResult<InstructorAssignmentDto>
@{ ViewData["Title"] = Localizer["InstructorAssignmentsTitle"]; var search = Context.Request.Query["Search"].ToString(); var instructors = (IReadOnlyList<LookupItem>)(ViewBag.Instructors ?? Array.Empty<LookupItem>()); var sections = (IReadOnlyList<LookupItem>)(ViewBag.Sections ?? Array.Empty<LookupItem>()); }
<section class="page-header"><div><p class="eyebrow">@Localizer["NavAcademicManagement"]</p><h1>@Localizer["InstructorAssignmentsTitle"]</h1><p>@Localizer["InstructorAssignmentsDescription"]</p></div><a class="btn btn-primary app-btn" asp-action="Create">@Localizer["CreateAssignment"]</a></section>
<section class="app-panel"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchAssignmentsPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="InstructorId">@Localizer["Instructor"]</label><select id="InstructorId" name="InstructorId" class="form-select"><option value="">@Localizer["AllInstructors"]</option>@foreach (var item in instructors) { <option value="@item.Value" selected="@(Context.Request.Query["InstructorId"] == item.Value)">@item.Text</option> }</select></div><div class="form-field"><label class="form-label" for="SectionId">@Localizer["Section"]</label><select id="SectionId" name="SectionId" class="form-select"><option value="">@Localizer["AllSections"]</option>@foreach (var item in sections) { <option value="@item.Value" selected="@(Context.Request.Query["SectionId"] == item.Value)">@item.Text</option> }</select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["Instructor"]</th><th>@Localizer["Course"]</th><th>@Localizer["Section"]</th><th>@Localizer["PrimaryInstructor"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="6">@Localizer["NoAssignments"]</td></tr> }
@foreach (var assignment in Model.Items) { <tr><td data-label="@Localizer["Instructor"]">@assignment.EmployeeNumber<br /><small>@assignment.InstructorNameEnglish / @assignment.InstructorNameArabic</small></td><td data-label="@Localizer["Course"]">@assignment.CourseCode<br /><small>@assignment.CourseNameEnglish</small></td><td data-label="@Localizer["Section"]">@assignment.SectionLabel</td><td data-label="@Localizer["PrimaryInstructor"]">@(assignment.IsPrimary ? Localizer["Yes"] : Localizer["No"])</td><td data-label="@Localizer["Status"]"><span class="status-badge @(assignment.IsActive ? "status-badge-success" : "status-badge-warning")">@(assignment.IsActive ? Localizer["Active"] : Localizer["Inactive"])</span></td><td data-label="@Localizer["Actions"]"><div class="row-actions"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@assignment.Id">@Localizer["Details"]</a><a class="btn btn-secondary btn-sm" asp-action="SetPrimary" asp-route-id="@assignment.Id">@Localizer["SetPrimary"]</a><form asp-action="Deactivate" asp-route-id="@assignment.Id" method="post" onsubmit="return confirm('@Localizer["ConfirmStatusChange"]');"><button class="btn btn-danger btn-sm" type="submit">@Localizer["Deactivate"]</button></form></div></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
