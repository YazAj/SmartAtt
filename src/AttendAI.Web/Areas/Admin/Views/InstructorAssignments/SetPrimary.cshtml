@model InstructorAssignmentPrimaryCommand
@{ ViewData["Title"] = Localizer["SetPrimary"]; }
<section class="page-header"><div><p class="eyebrow">@Localizer["InstructorAssignmentsTitle"]</p><h1>@Localizer["SetPrimary"]</h1><p>@Localizer["SetPrimaryDescription"]</p></div></section>
<section class="app-panel form-panel"><form method="post" class="app-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="RowVersion" type="hidden" /><div class="form-check app-check"><input asp-for="IsPrimary" class="form-check-input" /><label asp-for="IsPrimary" class="form-check-label">@Localizer["PrimaryInstructor"]</label></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["SaveChanges"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
