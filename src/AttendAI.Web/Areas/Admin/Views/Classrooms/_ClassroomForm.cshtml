@model ClassroomCommand
<section class="app-panel form-panel"><form method="post" class="app-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="RowVersion" type="hidden" /><div class="form-grid">
<div class="form-field"><label asp-for="Code" class="form-label field-required">@Localizer["Code"]</label><input asp-for="Code" class="form-control" /></div>
<div class="form-field"><label asp-for="BuildingNameEnglish" class="form-label field-required">@Localizer["BuildingNameEnglish"]</label><input asp-for="BuildingNameEnglish" class="form-control" /></div>
<div class="form-field"><label asp-for="BuildingNameArabic" class="form-label field-required">@Localizer["BuildingNameArabic"]</label><input asp-for="BuildingNameArabic" class="form-control" dir="rtl" /></div>
<div class="form-field"><label asp-for="RoomNumber" class="form-label field-required">@Localizer["RoomNumber"]</label><input asp-for="RoomNumber" class="form-control" /></div>
<div class="form-field"><label asp-for="Capacity" class="form-label field-required">@Localizer["Capacity"]</label><input asp-for="Capacity" type="number" min="1" class="form-control" /></div>
<div class="form-field"><label asp-for="Latitude" class="form-label">@Localizer["Latitude"]</label><input asp-for="Latitude" type="number" step="0.000001" class="form-control" /></div>
<div class="form-field"><label asp-for="Longitude" class="form-label">@Localizer["Longitude"]</label><input asp-for="Longitude" type="number" step="0.000001" class="form-control" /></div>
</div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["SaveChanges"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
