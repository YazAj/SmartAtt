@model ClassroomDto
@{ ViewData["Title"] = Localizer["ClassroomDetails"]; }
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["ClassroomsTitle"]</p><h1>@Model.Code</h1><small>@Model.BuildingNameEnglish / @Model.RoomNumber</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Edit" asp-route-id="@Model.Id">@Localizer["Edit"]</a><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Building"]</span><div class="detail-value">@Model.BuildingNameEnglish / @Model.BuildingNameArabic</div></div><div><span class="detail-label">@Localizer["RoomNumber"]</span><div class="detail-value">@Model.RoomNumber</div></div><div><span class="detail-label">@Localizer["Capacity"]</span><div class="detail-value">@Model.Capacity</div></div><div><span class="detail-label">@Localizer["Coordinates"]</span><div class="detail-value">@(Model.Latitude.HasValue ? $"{Model.Latitude}, {Model.Longitude}" : Localizer["NotProvided"])</div></div><div><span class="detail-label">@Localizer["Status"]</span><div class="detail-value">@(Model.IsActive ? Localizer["Active"] : Localizer["Inactive"])</div></div></div></section>
