@model PagedResult<ClassroomDto>
@{ ViewData["Title"] = Localizer["ClassroomsTitle"]; var search = Context.Request.Query["Search"].ToString(); var active = Context.Request.Query["IsActive"].ToString(); }
<section class="page-header"><div><p class="eyebrow">@Localizer["NavAcademicManagement"]</p><h1>@Localizer["ClassroomsTitle"]</h1><p>@Localizer["ClassroomsDescription"]</p></div><a class="btn btn-primary app-btn" asp-action="Create">@Localizer["CreateClassroom"]</a></section>
<section class="app-panel"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchClassroomsPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="IsActive">@Localizer["Status"]</label><select id="IsActive" name="IsActive" class="form-select"><option value="">@Localizer["AllStatuses"]</option><option value="true" selected="@(active == "true")">@Localizer["Active"]</option><option value="false" selected="@(active == "false")">@Localizer["Inactive"]</option></select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["Code"]</th><th>@Localizer["Building"]</th><th>@Localizer["RoomNumber"]</th><th>@Localizer["Capacity"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="6">@Localizer["NoClassrooms"]</td></tr> }
@foreach (var room in Model.Items) { <tr><td data-label="@Localizer["Code"]">@room.Code</td><td data-label="@Localizer["Building"]">@room.BuildingNameEnglish<br /><small>@room.BuildingNameArabic</small></td><td data-label="@Localizer["RoomNumber"]">@room.RoomNumber</td><td data-label="@Localizer["Capacity"]">@room.Capacity</td><td data-label="@Localizer["Status"]"><span class="status-badge @(room.IsActive ? "status-badge-success" : "status-badge-warning")">@(room.IsActive ? Localizer["Active"] : Localizer["Inactive"])</span></td><td data-label="@Localizer["Actions"]"><div class="row-actions"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@room.Id">@Localizer["Details"]</a><a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@room.Id">@Localizer["Edit"]</a><form asp-action="@(room.IsActive ? "Deactivate" : "Activate")" asp-route-id="@room.Id" method="post" onsubmit="return confirm('@Localizer["ConfirmStatusChange"]');"><button class="btn btn-sm @(room.IsActive ? "btn-danger" : "btn-primary")" type="submit">@(room.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])</button></form></div></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-IsActive="@active" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-IsActive="@active" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
