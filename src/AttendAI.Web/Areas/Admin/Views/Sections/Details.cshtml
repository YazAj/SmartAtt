@model SectionDto
@{ ViewData["Title"] = Localizer["SectionDetails"]; }
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["SectionsTitle"]</p><h1>@Model.CourseCode - @Model.SectionNumber</h1><small>@Model.AcademicYear / @Localizer[$"Semester{Model.Semester}"]</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Edit" asp-route-id="@Model.Id">@Localizer["Edit"]</a><a class="btn btn-secondary app-btn" asp-action="EnrolledStudents" asp-route-id="@Model.Id">@Localizer["ViewEnrolledStudents"]</a><a class="btn btn-secondary app-btn" asp-action="AssignedInstructors" asp-route-id="@Model.Id">@Localizer["ViewAssignedInstructors"]</a><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Course"]</span><div class="detail-value">@Model.CourseCode - @Model.CourseNameEnglish / @Model.CourseNameArabic</div></div><div><span class="detail-label">@Localizer["Capacity"]</span><div class="detail-value">@Model.ActiveEnrollmentCount / @Model.Capacity</div></div><div><span class="detail-label">@Localizer["AcademicYear"]</span><div class="detail-value">@Model.AcademicYear</div></div><div><span class="detail-label">@Localizer["Semester"]</span><div class="detail-value">@Localizer[$"Semester{Model.Semester}"]</div></div><div><span class="detail-label">@Localizer["Status"]</span><div class="detail-value">@(Model.IsActive ? Localizer["Active"] : Localizer["Inactive"])</div></div></div></section>
