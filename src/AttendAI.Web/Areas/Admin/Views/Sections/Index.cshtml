@model PagedResult<SectionDto>
@{
    ViewData["Title"] = Localizer["SectionsTitle"];
    var search = Context.Request.Query["Search"].ToString();
    var active = Context.Request.Query["IsActive"].ToString();
    var courses = (IReadOnlyList<LookupItem>)(ViewBag.Courses ?? Array.Empty<LookupItem>());
}
<section class="page-header"><div><p class="eyebrow">@Localizer["NavAcademicManagement"]</p><h1>@Localizer["SectionsTitle"]</h1><p>@Localizer["SectionsDescription"]</p></div><a class="btn btn-primary app-btn" asp-action="Create">@Localizer["CreateSection"]</a></section>
<section class="app-panel"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchSectionsPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="CourseId">@Localizer["Course"]</label><select id="CourseId" name="CourseId" class="form-select"><option value="">@Localizer["AllCourses"]</option>@foreach (var item in courses) { <option value="@item.Value" selected="@(Context.Request.Query["CourseId"] == item.Value)">@item.Text</option> }</select></div><div class="form-field"><label class="form-label" for="IsActive">@Localizer["Status"]</label><select id="IsActive" name="IsActive" class="form-select"><option value="">@Localizer["AllStatuses"]</option><option value="true" selected="@(active == "true")">@Localizer["Active"]</option><option value="false" selected="@(active == "false")">@Localizer["Inactive"]</option></select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["Course"]</th><th>@Localizer["SectionNumber"]</th><th>@Localizer["AcademicYear"]</th><th>@Localizer["Semester"]</th><th>@Localizer["Capacity"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="7">@Localizer["NoSections"]</td></tr> }
@foreach (var sectionItem in Model.Items) { <tr><td data-label="@Localizer["Course"]">@sectionItem.CourseCode<br /><small>@sectionItem.CourseNameEnglish / @sectionItem.CourseNameArabic</small></td><td data-label="@Localizer["SectionNumber"]">@sectionItem.SectionNumber</td><td data-label="@Localizer["AcademicYear"]">@sectionItem.AcademicYear</td><td data-label="@Localizer["Semester"]">@Localizer[$"Semester{sectionItem.Semester}"]</td><td data-label="@Localizer["Capacity"]">@sectionItem.ActiveEnrollmentCount / @sectionItem.Capacity</td><td data-label="@Localizer["Status"]"><span class="status-badge @(sectionItem.IsActive ? "status-badge-success" : "status-badge-warning")">@(sectionItem.IsActive ? Localizer["Active"] : Localizer["Inactive"])</span></td><td data-label="@Localizer["Actions"]"><div class="row-actions"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@sectionItem.Id">@Localizer["Details"]</a><a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@sectionItem.Id">@Localizer["Edit"]</a><form asp-action="@(sectionItem.IsActive ? "Deactivate" : "Activate")" asp-route-id="@sectionItem.Id" method="post" onsubmit="return confirm('@Localizer["ConfirmStatusChange"]');"><button class="btn btn-sm @(sectionItem.IsActive ? "btn-danger" : "btn-primary")" type="submit">@(sectionItem.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])</button></form></div></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-IsActive="@active" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-IsActive="@active" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
