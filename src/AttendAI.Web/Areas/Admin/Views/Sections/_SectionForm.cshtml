@model SectionCommand
@{ var courses = (IReadOnlyList<LookupItem>)(ViewBag.Courses ?? Array.Empty<LookupItem>()); }
<section class="app-panel form-panel"><form method="post" class="app-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="RowVersion" type="hidden" /><div class="form-grid">
<div class="form-field"><label asp-for="CourseId" class="form-label field-required">@Localizer["Course"]</label><select asp-for="CourseId" class="form-select"><option value="">@Localizer["SelectCourse"]</option>@foreach (var item in courses) { <option value="@item.Value">@item.Text</option> }</select></div>
<div class="form-field"><label asp-for="SectionNumber" class="form-label field-required">@Localizer["SectionNumber"]</label><input asp-for="SectionNumber" class="form-control" /></div>
<div class="form-field"><label asp-for="AcademicYear" class="form-label field-required">@Localizer["AcademicYear"]</label><input asp-for="AcademicYear" class="form-control" placeholder="2026/2027" /></div>
<div class="form-field"><label asp-for="Semester" class="form-label field-required">@Localizer["Semester"]</label><select asp-for="Semester" class="form-select">@foreach (var semester in Enum.GetValues<Semester>()) { <option value="@semester">@Localizer[$"Semester{semester}"]</option> }</select></div>
<div class="form-field"><label asp-for="Capacity" class="form-label field-required">@Localizer["Capacity"]</label><input asp-for="Capacity" type="number" min="1" class="form-control" /></div>
</div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["SaveChanges"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
