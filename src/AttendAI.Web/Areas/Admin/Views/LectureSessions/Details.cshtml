@model LectureSessionDto
@{
    ViewData["Title"] = Localizer["LectureSessionDetails"];
    var events = (IReadOnlyList<LectureSessionEventDto>)(ViewBag.Events ?? Array.Empty<LectureSessionEventDto>());
}
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["LectureSessionsTitle"]</p><h1 class="lecture-identifier-title"><span>@Model.CourseCode</span><span class="lecture-title-divider"> - </span><span>@Model.SectionNumber</span></h1><small>@Localizer[$"LectureSessionStatus{Model.Status}"]</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Instructor"]</span><div class="detail-value">@Model.InstructorNameEnglish / @Model.InstructorNameArabic</div></div><div><span class="detail-label">@Localizer["Classroom"]</span><div class="detail-value">@Model.ClassroomCode</div></div><div><span class="detail-label">@Localizer["ScheduledTime"]</span><div class="detail-value">@Model.ScheduledStartLocal.ToString("f") - @Model.ScheduledEndLocal.ToString("t")</div></div><div><span class="detail-label">@Localizer["ActualTime"]</span><div class="detail-value">@Model.ActualStartLocal.ToString("f")@(Model.ActualEndLocal.HasValue ? " - " + Model.ActualEndLocal.Value.ToString("t") : string.Empty)</div></div><div><span class="detail-label">@Localizer["SessionCodeState"]</span><div class="detail-value">@(Model.HasCodeHash && Model.HasProtectedCode ? Localizer["SessionCodeStoredSecurely"] : Localizer["SessionCodeInvalidated"])</div></div><div><span class="detail-label">@Localizer["CodeExpires"]</span><div class="detail-value">@(Model.SessionCodeExpiresAtLocal?.ToString("f") ?? Localizer["NotApplicable"])</div></div><div><span class="detail-label">@Localizer["LateThresholdMinutes"]</span><div class="detail-value">@Model.LateThresholdMinutes</div></div><div><span class="detail-label">@Localizer["AllowedRadiusMeters"]</span><div class="detail-value">@Model.AllowedRadiusMeters</div></div></div></section>
@if (Model.Status == LectureSessionStatus.Active)
{
    <section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["AdminForceEnd"]</h2><p>@Localizer["AdminForceEndDescription"]</p></div><form asp-action="ForceEnd" asp-route-id="@Model.Id" method="post" class="app-form"><input name="RowVersion" type="hidden" value="@Model.RowVersion" /><div class="form-field"><label class="form-label" for="Reason">@Localizer["Reason"]</label><input id="Reason" name="Reason" class="form-control" maxlength="300" /></div><div class="form-actions"><button class="btn btn-danger app-btn" type="submit">@Localizer["ForceEndSession"]</button></div></form></section>
}
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["LifecycleEvents"]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["OccurredAt"]</th><th>@Localizer["Event"]</th><th>@Localizer["PerformedBy"]</th><th>@Localizer["StatusChange"]</th><th>@Localizer["Description"]</th></tr></thead><tbody>
@if (events.Count == 0) { <tr><td class="empty-row" colspan="5">@Localizer["NoLifecycleEvents"]</td></tr> }
@foreach (var item in events) { <tr><td data-label="@Localizer["OccurredAt"]">@item.OccurredAtLocal.ToString("f")</td><td data-label="@Localizer["Event"]">@Localizer[$"LectureSessionEvent{item.EventType}"]</td><td data-label="@Localizer["PerformedBy"]">@item.PerformedByUserId</td><td data-label="@Localizer["StatusChange"]">@(item.PreviousStatus.HasValue ? Localizer[$"LectureSessionStatus{item.PreviousStatus.Value}"] : "-") &rarr; @(item.NewStatus.HasValue ? Localizer[$"LectureSessionStatus{item.NewStatus.Value}"] : "-")</td><td data-label="@Localizer["Description"]">@item.SafeDescription</td></tr> }
</tbody></table></div></section>
