@model PagedResult<LectureSessionDto>
@{
    ViewData["Title"] = Localizer["LectureSessionsTitle"];
    var search = Context.Request.Query["Search"].ToString();
}
<section class="page-header"><div><p class="eyebrow">@Localizer["NavLectureManagement"]</p><h1>@Localizer["LectureSessionsTitle"]</h1><p>@Localizer["LectureSessionsDescription"]</p></div><form asp-action="ExpireStale" method="post"><button class="btn btn-secondary app-btn" type="submit">@Localizer["ExpireStaleSessions"]</button></form></section>
<section class="app-panel"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchLectureSessionsPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="Status">@Localizer["Status"]</label><select id="Status" name="Status" class="form-select"><option value="">@Localizer["AllStatuses"]</option>@foreach (var status in Enum.GetValues<LectureSessionStatus>()) { <option value="@status" selected="@(Context.Request.Query["Status"] == status.ToString())">@Localizer[$"LectureSessionStatus{status}"]</option> }</select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["Course"]</th><th>@Localizer["Instructor"]</th><th>@Localizer["Classroom"]</th><th>@Localizer["SessionTime"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="6">@Localizer["NoLectureSessions"]</td></tr> }
@foreach (var session in Model.Items) { <tr><td data-label="@Localizer["Course"]">@session.CourseCode - @session.SectionNumber<br /><small>@session.CourseNameEnglish / @session.CourseNameArabic</small></td><td data-label="@Localizer["Instructor"]">@session.InstructorNameEnglish / @session.InstructorNameArabic</td><td data-label="@Localizer["Classroom"]">@session.ClassroomCode</td><td data-label="@Localizer["SessionTime"]">@session.ScheduledStartLocal.ToString("g") - @session.ScheduledEndLocal.ToString("t")</td><td data-label="@Localizer["Status"]"><span class="status-badge @(session.Status == LectureSessionStatus.Active ? "status-badge-success" : "status-badge-warning")">@Localizer[$"LectureSessionStatus{session.Status}"]</span></td><td data-label="@Localizer["Actions"]"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@session.Id">@Localizer["Details"]</a></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
