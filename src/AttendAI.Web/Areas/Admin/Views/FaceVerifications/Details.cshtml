@model AdminFaceVerificationAttemptDetailsDto
@{
    ViewData["Title"] = Localizer["FaceVerificationAttemptDetails"];
    var attempt = Model.Attempt;
    var metadata = Model.Metadata;
}
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["AdminFaceVerificationsTitle"]</p><h1>@attempt.StudentNumber</h1><small>@attempt.StudentNameEnglish / @attempt.StudentNameArabic</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Email"]</span><div class="detail-value">@attempt.Email</div></div><div><span class="detail-label">@Localizer["Department"]</span><div class="detail-value">@attempt.DepartmentNameEnglish / @attempt.DepartmentNameArabic</div></div><div><span class="detail-label">@Localizer["AttemptedAt"]</span><div class="detail-value">@attempt.AttemptedAtUtc.ToLocalTime().ToString("f")</div></div><div><span class="detail-label">@Localizer["Purpose"]</span><div class="detail-value">@Localizer[$"FaceVerificationPurpose{attempt.VerificationPurpose}"]</div></div><div><span class="detail-label">@Localizer["Outcome"]</span><div class="detail-value">@Localizer[$"FaceVerificationOutcome{attempt.Outcome}"]</div></div><div><span class="detail-label">@Localizer["Decision"]</span><div class="detail-value">@Localizer[$"FaceVerificationDecision{attempt.Decision}"]</div></div></div></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["SafeVerificationMetadata"]</h2><p>@Localizer["SafeVerificationMetadataText"]</p></div><div class="details-grid"><div><span class="detail-label">@Localizer["Score"]</span><div class="detail-value">@(metadata.Score?.ToString("0.######") ?? "-")</div></div><div><span class="detail-label">@Localizer["Threshold"]</span><div class="detail-value">@metadata.Threshold</div></div><div><span class="detail-label">@Localizer["ScoreMetric"]</span><div class="detail-value">@Localizer[$"ScoreMetric{metadata.ScoreMetric}"]</div></div><div><span class="detail-label">@Localizer["ErrorCode"]</span><div class="detail-value">@(string.IsNullOrWhiteSpace(metadata.ErrorCode) ? Localizer["NotApplicable"] : metadata.ErrorCode)</div></div><div><span class="detail-label">@Localizer["Engine"]</span><div class="detail-value">@metadata.EngineName @metadata.EngineVersion</div></div><div><span class="detail-label">@Localizer["Model"]</span><div class="detail-value">@metadata.ModelName @metadata.ModelVersion</div></div><div><span class="detail-label">@Localizer["ImageDimensions"]</span><div class="detail-value">@(metadata.ImageWidth.HasValue && metadata.ImageHeight.HasValue ? $"{metadata.ImageWidth} x {metadata.ImageHeight}" : Localizer["NotApplicable"])</div></div><div><span class="detail-label">@Localizer["DetectedFaceCount"]</span><div class="detail-value">@(metadata.DetectedFaceCount?.ToString() ?? Localizer["NotApplicable"])</div></div><div><span class="detail-label">@Localizer["QualityScore"]</span><div class="detail-value">@(metadata.QualityScore?.ToString("0.####") ?? Localizer["NotApplicable"])</div></div><div><span class="detail-label">@Localizer["ProcessingTime"]</span><div class="detail-value">@(metadata.ProcessingDurationMilliseconds?.ToString() ?? "-") @Localizer["MillisecondsShort"]</div></div><div><span class="detail-label">@Localizer["TemplateFormatVersion"]</span><div class="detail-value">@metadata.TemplateFormatVersion</div></div><div><span class="detail-label">@Localizer["TemplateReference"]</span><div class="detail-value">@(metadata.FaceTemplateId.HasValue ? Localizer["Yes"] : Localizer["No"])</div></div></div></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["Description"]</h2></div><p>@Localizer[metadata.SafeDescription]</p></section>
