@model PagedResult<AdminFaceVerificationAttemptRowDto>
@{
    ViewData["Title"] = Localizer["AdminFaceVerificationsTitle"];
    var search = Context.Request.Query["Search"].ToString();
    var outcome = Context.Request.Query["Outcome"].ToString();
    var decision = Context.Request.Query["Decision"].ToString();
    var diagnostics = (FaceEngineDiagnosticsDto?)ViewBag.Diagnostics;
}
<section class="page-header"><div><p class="eyebrow">@Localizer["AdminRole"]</p><h1>@Localizer["AdminFaceVerificationsTitle"]</h1><p>@Localizer["AdminFaceVerificationsLead"]</p></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Diagnostics">@Localizer["EngineDiagnostics"]</a></div></section>
<section class="app-panel"><div class="section-heading"><h2>@Localizer["VerificationDiagnostics"]</h2><p>@Localizer[diagnostics?.StatusMessageKey ?? "FaceVerificationEngineDisabledMessage"]</p></div><div class="details-grid"><div><span class="detail-label">@Localizer["EngineMode"]</span><div class="detail-value">@diagnostics?.Mode</div></div><div><span class="detail-label">@Localizer["GateResult"]</span><div class="detail-value">@diagnostics?.GateResult</div></div><div><span class="detail-label">@Localizer["Threshold"]</span><div class="detail-value">@diagnostics?.Threshold</div></div><div><span class="detail-label">@Localizer["ScoreMetric"]</span><div class="detail-value">@Localizer[$"ScoreMetric{diagnostics?.ScoreMetric}"]</div></div></div></section>
<section class="app-panel mt-3"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchVerificationAttemptsPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="Outcome">@Localizer["Outcome"]</label><select id="Outcome" name="Outcome" class="form-select"><option value="">@Localizer["AllStatuses"]</option>@foreach (var item in Enum.GetValues<FaceVerificationOutcome>()) { <option value="@item" selected="@(outcome == item.ToString())">@Localizer[$"FaceVerificationOutcome{item}"]</option> }</select></div><div class="form-field"><label class="form-label" for="Decision">@Localizer["Decision"]</label><select id="Decision" name="Decision" class="form-select"><option value="">@Localizer["AllStatuses"]</option>@foreach (var item in Enum.GetValues<FaceVerificationDecision>()) { <option value="@item" selected="@(decision == item.ToString())">@Localizer[$"FaceVerificationDecision{item}"]</option> }</select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["AttemptedAt"]</th><th>@Localizer["StudentNumber"]</th><th>@Localizer["Outcome"]</th><th>@Localizer["Decision"]</th><th>@Localizer["Score"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="6">@Localizer["NoFaceVerificationAttempts"]</td></tr> }
@foreach (var row in Model.Items) { <tr><td data-label="@Localizer["AttemptedAt"]">@row.AttemptedAtUtc.ToLocalTime().ToString("f")</td><td data-label="@Localizer["StudentNumber"]">@row.StudentNumber<br /><small>@row.StudentNameEnglish / @row.StudentNameArabic</small></td><td data-label="@Localizer["Outcome"]">@Localizer[$"FaceVerificationOutcome{row.Outcome}"]</td><td data-label="@Localizer["Decision"]">@Localizer[$"FaceVerificationDecision{row.Decision}"]</td><td data-label="@Localizer["Score"]">@(row.Score?.ToString("0.######") ?? "-")</td><td data-label="@Localizer["Actions"]"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@row.Id">@Localizer["Details"]</a></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-Outcome="@outcome" asp-route-Decision="@decision" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-Outcome="@outcome" asp-route-Decision="@decision" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
