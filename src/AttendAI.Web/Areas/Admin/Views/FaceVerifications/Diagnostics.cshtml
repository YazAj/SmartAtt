@model FaceEngineDiagnosticsDto
@{
    ViewData["Title"] = Localizer["EngineDiagnostics"];
}
<section class="page-header"><div><p class="eyebrow">@Localizer["AdminFaceVerificationsTitle"]</p><h1>@Localizer["EngineDiagnostics"]</h1><p>@Localizer[Model.StatusMessageKey]</p></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["EngineMode"]</span><div class="detail-value">@Model.Mode</div></div><div><span class="detail-label">@Localizer["Engine"]</span><div class="detail-value">@Model.EngineName @Model.EngineVersion</div></div><div><span class="detail-label">@Localizer["Model"]</span><div class="detail-value">@Model.ModelName @Model.ModelVersion</div></div><div><span class="detail-label">@Localizer["GateResult"]</span><div class="detail-value">@Model.GateResult</div></div><div><span class="detail-label">@Localizer["VerificationEnabled"]</span><div class="detail-value">@(Model.VerificationEnabled ? Localizer["Yes"] : Localizer["No"])</div></div><div><span class="detail-label">@Localizer["DemoMode"]</span><div class="detail-value">@(Model.IsDemoMode ? Localizer["Yes"] : Localizer["No"])</div></div><div><span class="detail-label">@Localizer["Threshold"]</span><div class="detail-value">@Model.Threshold</div></div><div><span class="detail-label">@Localizer["ScoreMetric"]</span><div class="detail-value">@Localizer[$"ScoreMetric{Model.ScoreMetric}"]</div></div><div><span class="detail-label">@Localizer["RateLimit"]</span><div class="detail-value">@Localizer["VerificationRateLimitSummary", Model.MaximumAttemptsPerWindow, Model.AttemptWindowMinutes, Model.CooldownSeconds]</div></div><div><span class="detail-label">@Localizer["TemplateFormatVersion"]</span><div class="detail-value">@Model.ExpectedTemplateFormatVersion</div></div><div><span class="detail-label">@Localizer["EmbeddingDimension"]</span><div class="detail-value">@Model.ExpectedEmbeddingDimension</div></div><div><span class="detail-label">@Localizer["ProductionSafe"]</span><div class="detail-value">@(Model.IsProductionSafe ? Localizer["Yes"] : Localizer["No"])</div></div></div></section>
