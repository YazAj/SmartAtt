@model PagedResult<StudentDto>
@{ ViewData["Title"] = Localizer["StudentsTitle"]; var search = Context.Request.Query["Search"].ToString(); var active = Context.Request.Query["IsActive"].ToString(); var departments = (IReadOnlyList<LookupItem>)(ViewBag.Departments ?? Array.Empty<LookupItem>()); }
<section class="page-header"><div><p class="eyebrow">@Localizer["NavAcademicManagement"]</p><h1>@Localizer["StudentsTitle"]</h1><p>@Localizer["StudentsDescription"]</p></div><a class="btn btn-primary app-btn" asp-action="Create">@Localizer["CreateStudent"]</a></section>
<section class="app-panel"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchStudentsPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="DepartmentId">@Localizer["Department"]</label><select id="DepartmentId" name="DepartmentId" class="form-select"><option value="">@Localizer["AllDepartments"]</option>@foreach (var item in departments) { <option value="@item.Value" selected="@(Context.Request.Query["DepartmentId"] == item.Value)">@item.Text</option> }</select></div><div class="form-field"><label class="form-label" for="IsActive">@Localizer["Status"]</label><select id="IsActive" name="IsActive" class="form-select"><option value="">@Localizer["AllStatuses"]</option><option value="true" selected="@(active == "true")">@Localizer["Active"]</option><option value="false" selected="@(active == "false")">@Localizer["Inactive"]</option></select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["StudentNumber"]</th><th>@Localizer["NameEnglish"]</th><th>@Localizer["Email"]</th><th>@Localizer["Department"]</th><th>@Localizer["AcademicLevel"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="7">@Localizer["NoStudents"]</td></tr> }
@foreach (var student in Model.Items) { <tr><td data-label="@Localizer["StudentNumber"]">@student.StudentNumber</td><td data-label="@Localizer["NameEnglish"]">@student.NameEnglish<br /><small>@student.NameArabic</small></td><td data-label="@Localizer["Email"]">@student.Email</td><td data-label="@Localizer["Department"]">@student.DepartmentNameEnglish</td><td data-label="@Localizer["AcademicLevel"]">@student.AcademicLevel</td><td data-label="@Localizer["Status"]"><span class="status-badge @(student.IsActive ? "status-badge-success" : "status-badge-warning")">@(student.IsActive ? Localizer["Active"] : Localizer["Inactive"])</span></td><td data-label="@Localizer["Actions"]"><div class="row-actions"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@student.Id">@Localizer["Details"]</a><a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@student.Id">@Localizer["Edit"]</a><a class="btn btn-secondary btn-sm" asp-action="ResetPassword" asp-route-id="@student.Id">@Localizer["ResetPassword"]</a><form asp-action="@(student.IsActive ? "Deactivate" : "Activate")" asp-route-id="@student.Id" method="post" onsubmit="return confirm('@Localizer["ConfirmStatusChange"]');"><button class="btn btn-sm @(student.IsActive ? "btn-danger" : "btn-primary")" type="submit">@(student.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])</button></form></div></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-IsActive="@active" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-IsActive="@active" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
