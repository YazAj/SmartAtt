@model StudentAccountCommand
@{ ViewData["Title"] = Localizer["CreateStudent"]; var departments = (IReadOnlyList<LookupItem>)(ViewBag.Departments ?? Array.Empty<LookupItem>()); }
<section class="page-header"><div><p class="eyebrow">@Localizer["StudentsTitle"]</p><h1>@Localizer["CreateStudent"]</h1><p>@Localizer["StudentCreateDescription"]</p></div></section>
<section class="app-panel form-panel"><form method="post" class="app-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid">
<div class="form-field"><label asp-for="Email" class="form-label field-required">@Localizer["Email"]</label><input asp-for="Email" type="email" class="form-control" /></div>
<div class="form-field"><label asp-for="TemporaryPassword" class="form-label field-required">@Localizer["TemporaryPassword"]</label><input asp-for="TemporaryPassword" type="password" class="form-control" autocomplete="new-password" /></div>
<div class="form-field"><label asp-for="ConfirmTemporaryPassword" class="form-label field-required">@Localizer["ConfirmPassword"]</label><input asp-for="ConfirmTemporaryPassword" type="password" class="form-control" autocomplete="new-password" /></div>
<div class="form-field"><label asp-for="StudentNumber" class="form-label field-required">@Localizer["StudentNumber"]</label><input asp-for="StudentNumber" class="form-control" /></div>
<div class="form-field"><label asp-for="NameEnglish" class="form-label field-required">@Localizer["NameEnglish"]</label><input asp-for="NameEnglish" class="form-control" /></div>
<div class="form-field"><label asp-for="NameArabic" class="form-label field-required">@Localizer["NameArabic"]</label><input asp-for="NameArabic" class="form-control" dir="rtl" /></div>
<div class="form-field"><label asp-for="DepartmentId" class="form-label field-required">@Localizer["Department"]</label><select asp-for="DepartmentId" class="form-select"><option value="">@Localizer["SelectDepartment"]</option>@foreach (var item in departments) { <option value="@item.Value">@item.Text</option> }</select></div>
<div class="form-field"><label asp-for="EnrollmentYear" class="form-label field-required">@Localizer["EnrollmentYear"]</label><input asp-for="EnrollmentYear" type="number" min="2000" max="2100" class="form-control" /></div>
<div class="form-field"><label asp-for="AcademicLevel" class="form-label field-required">@Localizer["AcademicLevel"]</label><input asp-for="AcademicLevel" class="form-control" /></div>
</div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["CreateStudent"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
