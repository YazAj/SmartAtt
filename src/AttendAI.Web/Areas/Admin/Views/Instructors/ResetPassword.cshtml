@model TemporaryPasswordCommand
@{ ViewData["Title"] = Localizer["ResetPassword"]; }
<section class="page-header"><div><p class="eyebrow">@Localizer["InstructorsTitle"]</p><h1>@Localizer["ResetPassword"]</h1><p>@Localizer["ResetPasswordDescription"]</p></div></section>
<section class="app-panel form-panel"><form method="post" class="app-form" onsubmit="return confirm('@Localizer["ConfirmPasswordReset"]');">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="form-field"><label asp-for="TemporaryPassword" class="form-label field-required">@Localizer["TemporaryPassword"]</label><input asp-for="TemporaryPassword" type="password" class="form-control" autocomplete="new-password" /></div><div class="form-field"><label asp-for="ConfirmTemporaryPassword" class="form-label field-required">@Localizer["ConfirmPassword"]</label><input asp-for="ConfirmTemporaryPassword" type="password" class="form-control" autocomplete="new-password" /></div></div><div class="form-actions"><button class="btn btn-danger app-btn" type="submit">@Localizer["ResetPassword"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
