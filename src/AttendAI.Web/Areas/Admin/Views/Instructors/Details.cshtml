@model InstructorDto
@{ ViewData["Title"] = Localizer["InstructorDetails"]; }
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["InstructorsTitle"]</p><h1>@Model.EmployeeNumber</h1><small>@Model.NameEnglish / @Model.NameArabic</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Edit" asp-route-id="@Model.Id">@Localizer["Edit"]</a><a class="btn btn-secondary app-btn" asp-action="Assignments" asp-route-id="@Model.Id">@Localizer["ViewAssignedSections"]</a><a class="btn btn-secondary app-btn" asp-action="ResetPassword" asp-route-id="@Model.Id">@Localizer["ResetPassword"]</a><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Email"]</span><div class="detail-value">@Model.Email</div></div><div><span class="detail-label">@Localizer["Status"]</span><div class="detail-value">@(Model.IsActive ? Localizer["Active"] : Localizer["Inactive"])</div></div><div><span class="detail-label">@Localizer["Department"]</span><div class="detail-value">@Model.DepartmentNameEnglish / @Model.DepartmentNameArabic</div></div><div><span class="detail-label">@Localizer["AcademicTitleField"]</span><div class="detail-value">@Model.AcademicTitle</div></div><div><span class="detail-label">@Localizer["MustChangePassword"]</span><div class="detail-value">@(Model.MustChangePassword ? Localizer["Yes"] : Localizer["No"])</div></div></div></section>
