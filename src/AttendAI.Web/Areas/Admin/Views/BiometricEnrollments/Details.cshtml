@model AdminBiometricEnrollmentDetailsDto
@{
    ViewData["Title"] = Localizer["AdminBiometricEnrollmentDetails"];
    var activeTemplate = Model.ActiveTemplate;
}
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["AdminBiometricEnrollmentsTitle"]</p><h1>@Model.StudentNumber</h1><small>@Model.StudentNameEnglish / @Model.StudentNameArabic</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Email"]</span><div class="detail-value">@Model.Email</div></div><div><span class="detail-label">@Localizer["Department"]</span><div class="detail-value">@Model.DepartmentNameEnglish / @Model.DepartmentNameArabic</div></div><div><span class="detail-label">@Localizer["StudentStatus"]</span><div class="detail-value">@(Model.StudentIsActive ? Localizer["Active"] : Localizer["Inactive"])</div></div><div><span class="detail-label">@Localizer["BiometricStatus"]</span><div class="detail-value">@Localizer[$"FaceEnrollmentStatus{Model.Status.Status}"]</div></div><div><span class="detail-label">@Localizer["Consent"]</span><div class="detail-value">@(Model.Status.HasActiveConsent ? Localizer["Active"] : Localizer["NotActive"])</div></div><div><span class="detail-label">@Localizer["EnrolledAt"]</span><div class="detail-value">@(Model.Status.EnrolledAtUtc?.ToLocalTime().ToString("f") ?? Localizer["NotApplicable"])</div></div></div></section>
@if (activeTemplate is not null)
{
    <section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ActiveTemplateMetadata"]</h2><p>@Localizer["TemplateMetadataSafeText"]</p></div><div class="details-grid"><div><span class="detail-label">@Localizer["Engine"]</span><div class="detail-value">@activeTemplate.EngineName @activeTemplate.EngineVersion</div></div><div><span class="detail-label">@Localizer["Model"]</span><div class="detail-value">@activeTemplate.ModelName @activeTemplate.ModelVersion</div></div><div><span class="detail-label">@Localizer["QualityScore"]</span><div class="detail-value">@activeTemplate.QualityScore</div></div><div><span class="detail-label">@Localizer["CaptureCount"]</span><div class="detail-value">@activeTemplate.CaptureCount</div></div><div><span class="detail-label">@Localizer["TemplateVersion"]</span><div class="detail-value">@activeTemplate.TemplateVersion</div></div><div><span class="detail-label">@Localizer["EmbeddingDimension"]</span><div class="detail-value">@activeTemplate.EmbeddingDimension</div></div></div></section>
    <section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["AdminBiometricActions"]</h2><p>@Localizer["AdminBiometricActionsText"]</p></div><div class="form-grid"><form asp-action="Revoke" asp-route-id="@Model.StudentId" method="post" class="app-form"><input name="RowVersion" type="hidden" value="@activeTemplate.RowVersion" /><div class="form-field"><label class="form-label" for="RevokeReason">@Localizer["Reason"]</label><input id="RevokeReason" name="Reason" class="form-control" maxlength="300" required /></div><button class="btn btn-danger app-btn" type="submit">@Localizer["RevokeTemplate"]</button></form><form asp-action="RequireReEnrollment" asp-route-id="@Model.StudentId" method="post" class="app-form"><input name="RowVersion" type="hidden" value="@activeTemplate.RowVersion" /><div class="form-field"><label class="form-label" for="ReEnrollmentReason">@Localizer["Reason"]</label><input id="ReEnrollmentReason" name="Reason" class="form-control" maxlength="300" required /></div><button class="btn btn-secondary app-btn" type="submit">@Localizer["RequireReEnrollment"]</button></form></div></section>
}
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["TemplateHistory"]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["TemplateVersion"]</th><th>@Localizer["Engine"]</th><th>@Localizer["EnrolledAt"]</th><th>@Localizer["RevokedAt"]</th><th>@Localizer["Status"]</th></tr></thead><tbody>
@if (Model.TemplateHistory.Count == 0) { <tr><td class="empty-row" colspan="5">@Localizer["NoTemplateHistory"]</td></tr> }
@foreach (var template in Model.TemplateHistory) { <tr><td data-label="@Localizer["TemplateVersion"]">@template.TemplateVersion</td><td data-label="@Localizer["Engine"]">@template.EngineName</td><td data-label="@Localizer["EnrolledAt"]">@template.EnrolledAtUtc.ToLocalTime().ToString("f")</td><td data-label="@Localizer["RevokedAt"]">@(template.RevokedAtUtc?.ToLocalTime().ToString("f") ?? "-")</td><td data-label="@Localizer["Status"]">@(template.IsActive ? Localizer["Active"] : Localizer["Inactive"])</td></tr> }
</tbody></table></div></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["BiometricEnrollmentEvents"]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["OccurredAt"]</th><th>@Localizer["Event"]</th><th>@Localizer["PerformedBy"]</th><th>@Localizer["Outcome"]</th><th>@Localizer["Description"]</th></tr></thead><tbody>
@if (Model.Events.Count == 0) { <tr><td class="empty-row" colspan="5">@Localizer["NoBiometricEvents"]</td></tr> }
@foreach (var item in Model.Events) { <tr><td data-label="@Localizer["OccurredAt"]">@item.OccurredAtUtc.ToLocalTime().ToString("f")</td><td data-label="@Localizer["Event"]">@Localizer[$"FaceEnrollmentEvent{item.EventType}"]</td><td data-label="@Localizer["PerformedBy"]">@item.PerformedByUserId</td><td data-label="@Localizer["Outcome"]">@Localizer[$"Outcome{item.Outcome}"]</td><td data-label="@Localizer["Description"]">@Localizer[item.SafeDescription]</td></tr> }
</tbody></table></div></section>
