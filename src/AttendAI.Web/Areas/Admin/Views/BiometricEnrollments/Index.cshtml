@model PagedResult<AdminBiometricEnrollmentRowDto>
@{
    ViewData["Title"] = Localizer["AdminBiometricEnrollmentsTitle"];
    var search = Context.Request.Query["Search"].ToString();
    var status = Context.Request.Query["Status"].ToString();
    var readiness = (FaceEngineReadinessDto?)ViewBag.EngineReadiness;
}
<section class="page-header"><div><p class="eyebrow">@Localizer["AdminRole"]</p><h1>@Localizer["AdminBiometricEnrollmentsTitle"]</h1><p>@Localizer["AdminBiometricEnrollmentsLead"]</p></div></section>
<section class="app-panel"><div class="section-heading"><h2>@Localizer["FaceEngineReadiness"]</h2><p>@Localizer[readiness?.StatusMessageKey ?? "BiometricEngineDisabledMessage"]</p></div><div class="details-grid"><div><span class="detail-label">@Localizer["EngineMode"]</span><div class="detail-value">@readiness?.Mode</div></div><div><span class="detail-label">@Localizer["GateResult"]</span><div class="detail-value">@readiness?.GateResult</div></div><div><span class="detail-label">@Localizer["Model"]</span><div class="detail-value">@readiness?.ModelName @readiness?.ModelVersion</div></div><div><span class="detail-label">@Localizer["ProductionSafe"]</span><div class="detail-value">@((readiness?.IsProductionSafe ?? false) ? Localizer["Yes"] : Localizer["No"])</div></div></div></section>
<section class="app-panel mt-3"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchBiometricsPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="Status">@Localizer["BiometricStatus"]</label><select id="Status" name="Status" class="form-select"><option value="">@Localizer["AllStatuses"]</option>@foreach (var item in Enum.GetValues<FaceEnrollmentStatus>()) { <option value="@item" selected="@(status == item.ToString())">@Localizer[$"FaceEnrollmentStatus{item}"]</option> }</select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["StudentNumber"]</th><th>@Localizer["NameEnglish"]</th><th>@Localizer["Department"]</th><th>@Localizer["BiometricStatus"]</th><th>@Localizer["Engine"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="6">@Localizer["NoBiometricEnrollments"]</td></tr> }
@foreach (var row in Model.Items) { <tr><td data-label="@Localizer["StudentNumber"]">@row.StudentNumber</td><td data-label="@Localizer["NameEnglish"]">@row.StudentNameEnglish<br /><small>@row.StudentNameArabic</small></td><td data-label="@Localizer["Department"]">@row.DepartmentNameEnglish<br /><small>@row.DepartmentNameArabic</small></td><td data-label="@Localizer["BiometricStatus"]"><span class="status-badge">@Localizer[$"FaceEnrollmentStatus{row.Status}"]</span></td><td data-label="@Localizer["Engine"]">@(row.EngineName ?? Localizer["NotApplicable"])</td><td data-label="@Localizer["Actions"]"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@row.StudentId">@Localizer["Details"]</a></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-Status="@status" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-Status="@status" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
