@model StudentEnrollmentDto
@{ ViewData["Title"] = Localizer["EnrollmentDetails"]; }
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["EnrollmentsTitle"]</p><h1>@Model.StudentNumber</h1><small>@Model.SectionLabel</small></div><div class="page-actions"><a class="btn btn-secondary app-btn" asp-action="ChangeStatus" asp-route-id="@Model.Id">@Localizer["ChangeStatus"]</a><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToList"]</a></div></section>
<section class="app-panel"><div class="details-grid"><div><span class="detail-label">@Localizer["Student"]</span><div class="detail-value">@Model.StudentNameEnglish / @Model.StudentNameArabic</div></div><div><span class="detail-label">@Localizer["Course"]</span><div class="detail-value">@Model.CourseCode - @Model.CourseNameEnglish / @Model.CourseNameArabic</div></div><div><span class="detail-label">@Localizer["Section"]</span><div class="detail-value">@Model.SectionLabel</div></div><div><span class="detail-label">@Localizer["EnrollmentStatus"]</span><div class="detail-value">@Localizer[$"EnrollmentStatus{Model.EnrollmentStatus}"]</div></div><div><span class="detail-label">@Localizer["EnrolledAtUtc"]</span><div class="detail-value">@Model.EnrolledAtUtc.ToString("u")</div></div></div></section>
