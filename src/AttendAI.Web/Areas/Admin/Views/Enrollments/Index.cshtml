@model PagedResult<StudentEnrollmentDto>
@{ ViewData["Title"] = Localizer["EnrollmentsTitle"]; var search = Context.Request.Query["Search"].ToString(); var students = (IReadOnlyList<LookupItem>)(ViewBag.Students ?? Array.Empty<LookupItem>()); var sections = (IReadOnlyList<LookupItem>)(ViewBag.Sections ?? Array.Empty<LookupItem>()); }
<section class="page-header"><div><p class="eyebrow">@Localizer["NavAcademicManagement"]</p><h1>@Localizer["EnrollmentsTitle"]</h1><p>@Localizer["EnrollmentsDescription"]</p></div><a class="btn btn-primary app-btn" asp-action="Create">@Localizer["CreateEnrollment"]</a></section>
<section class="app-panel"><form method="get" class="filter-grid"><div class="form-field"><label class="form-label" for="Search">@Localizer["Search"]</label><input id="Search" name="Search" value="@search" class="form-control" placeholder="@Localizer["SearchEnrollmentsPlaceholder"]" /></div><div class="form-field"><label class="form-label" for="StudentId">@Localizer["Student"]</label><select id="StudentId" name="StudentId" class="form-select"><option value="">@Localizer["AllStudents"]</option>@foreach (var item in students) { <option value="@item.Value" selected="@(Context.Request.Query["StudentId"] == item.Value)">@item.Text</option> }</select></div><div class="form-field"><label class="form-label" for="SectionId">@Localizer["Section"]</label><select id="SectionId" name="SectionId" class="form-select"><option value="">@Localizer["AllSections"]</option>@foreach (var item in sections) { <option value="@item.Value" selected="@(Context.Request.Query["SectionId"] == item.Value)">@item.Text</option> }</select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["Search"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Reset"]</a></div></form></section>
<section class="app-panel mt-3"><div class="section-heading"><h2>@Localizer["ResultsCount", Model.TotalCount]</h2></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>@Localizer["Student"]</th><th>@Localizer["Course"]</th><th>@Localizer["Section"]</th><th>@Localizer["Semester"]</th><th>@Localizer["EnrollmentStatus"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td class="empty-row" colspan="6">@Localizer["NoEnrollments"]</td></tr> }
@foreach (var enrollment in Model.Items) { <tr><td data-label="@Localizer["Student"]">@enrollment.StudentNumber<br /><small>@enrollment.StudentNameEnglish / @enrollment.StudentNameArabic</small></td><td data-label="@Localizer["Course"]">@enrollment.CourseCode<br /><small>@enrollment.CourseNameEnglish</small></td><td data-label="@Localizer["Section"]">@enrollment.SectionLabel</td><td data-label="@Localizer["Semester"]">@enrollment.AcademicYear / @Localizer[$"Semester{enrollment.Semester}"]</td><td data-label="@Localizer["EnrollmentStatus"]"><span class="status-badge @(enrollment.IsActive ? "status-badge-success" : "status-badge-warning")">@Localizer[$"EnrollmentStatus{enrollment.EnrollmentStatus}"]</span></td><td data-label="@Localizer["Actions"]"><div class="row-actions"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@enrollment.Id">@Localizer["Details"]</a><a class="btn btn-secondary btn-sm" asp-action="ChangeStatus" asp-route-id="@enrollment.Id">@Localizer["ChangeStatus"]</a><form asp-action="Deactivate" asp-route-id="@enrollment.Id" method="post" onsubmit="return confirm('@Localizer["ConfirmStatusChange"]');"><button class="btn btn-danger btn-sm" type="submit">@Localizer["Deactivate"]</button></form></div></td></tr> }
</tbody></table></div><div class="pagination-wrap"><span>@Localizer["PageOf", Model.PageNumber, Model.TotalPages]</span><div class="row-actions"><a class="btn btn-secondary app-btn @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-PageNumber="@(Model.PageNumber - 1)">@Localizer["Previous"]</a><a class="btn btn-secondary app-btn @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-Search="@search" asp-route-PageNumber="@(Model.PageNumber + 1)">@Localizer["Next"]</a></div></div></section>
