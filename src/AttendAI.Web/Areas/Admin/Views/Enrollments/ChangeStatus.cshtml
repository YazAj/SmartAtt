@model EnrollmentStatusCommand
@{ ViewData["Title"] = Localizer["ChangeStatus"]; }
<section class="page-header"><div><p class="eyebrow">@Localizer["EnrollmentsTitle"]</p><h1>@Localizer["ChangeStatus"]</h1><p>@Localizer["ChangeEnrollmentStatusDescription"]</p></div></section>
<section class="app-panel form-panel"><form method="post" class="app-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="RowVersion" type="hidden" /><div class="form-field"><label asp-for="EnrollmentStatus" class="form-label field-required">@Localizer["EnrollmentStatus"]</label><select asp-for="EnrollmentStatus" class="form-select">@foreach (var status in Enum.GetValues<EnrollmentStatus>()) { <option value="@status">@Localizer[$"EnrollmentStatus{status}"]</option> }</select></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["SaveChanges"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
