@model EnrollmentCommand
@{ ViewData["Title"] = Localizer["CreateEnrollment"]; var students = (IReadOnlyList<LookupItem>)(ViewBag.Students ?? Array.Empty<LookupItem>()); var sections = (IReadOnlyList<LookupItem>)(ViewBag.Sections ?? Array.Empty<LookupItem>()); }
<section class="page-header"><div><p class="eyebrow">@Localizer["EnrollmentsTitle"]</p><h1>@Localizer["CreateEnrollment"]</h1><p>@Localizer["EnrollmentFormDescription"]</p></div></section>
<section class="app-panel form-panel"><form method="post" class="app-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="form-field"><label asp-for="StudentId" class="form-label field-required">@Localizer["Student"]</label><select asp-for="StudentId" class="form-select"><option value="">@Localizer["SelectStudent"]</option>@foreach (var item in students) { <option value="@item.Value">@item.Text</option> }</select></div><div class="form-field"><label asp-for="SectionId" class="form-label field-required">@Localizer["Section"]</label><select asp-for="SectionId" class="form-select"><option value="">@Localizer["SelectSection"]</option>@foreach (var item in sections) { <option value="@item.Value">@item.Text</option> }</select></div></div><div class="form-actions"><button class="btn btn-primary app-btn" type="submit">@Localizer["CreateEnrollment"]</button><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["Cancel"]</a></div></form></section>
