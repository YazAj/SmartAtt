@model LectureSessionDto
@{
    ViewData["Title"] = Localizer["ActiveLectureSession"];
    var plainCode = ViewBag.PlainSessionCode as string;
    DateTimeOffset? codeExpiresAtLocal = ViewBag.SessionCodeExpiresAtLocal is DateTimeOffset localExpiry ? localExpiry : null;
    var codeCountdownTarget = Model.SessionCodeExpiresAtUtc.HasValue ? Model.SessionCodeExpiresAtUtc.Value.UtcDateTime.ToString("O") : string.Empty;
    var sessionCountdownTarget = Model.ScheduledEndUtc.UtcDateTime.ToString("O");
}
<section class="page-header"><div class="entity-title"><p class="eyebrow">@Localizer["InstructorRole"]</p><h1 class="lecture-identifier-title"><span>@Model.CourseCode</span><span class="lecture-title-divider"> - </span><span>@Model.SectionNumber</span></h1><small>@Localizer[$"LectureSessionStatus{Model.Status}"]</small></div><a class="btn btn-secondary app-btn" asp-action="Index">@Localizer["BackToSchedule"]</a></section>
@if (!string.IsNullOrWhiteSpace(plainCode))
{
    <section class="session-code-panel" aria-live="polite"><span>@Localizer["TemporarySessionCode"]</span><strong id="sessionCodeValue">@plainCode</strong><small>@Localizer["CodeVisibleOnlyNow"]</small><button class="btn btn-secondary app-btn" type="button" data-copy-target="#sessionCodeValue">@Localizer["CopyCode"]</button></section>
}
<section class="dashboard-grid">
    <article class="stat-card"><span>@Localizer["CodeCountdown"]</span><strong data-countdown-target="@codeCountdownTarget">--:--</strong><p>@(codeExpiresAtLocal?.ToString("f") ?? Model.SessionCodeExpiresAtLocal?.ToString("f") ?? Localizer["NotApplicable"])</p></article>
    <article class="stat-card"><span>@Localizer["SessionCountdown"]</span><strong data-countdown-target="@sessionCountdownTarget">--:--</strong><p>@Model.ScheduledStartLocal.ToString("t") - @Model.ScheduledEndLocal.ToString("t")</p></article>
    <article class="stat-card"><span>@Localizer["Classroom"]</span><strong>@Model.ClassroomCode</strong><p>@Localizer["LateMinutesShort", Model.LateThresholdMinutes] / @Localizer["RadiusMetersShort", Model.AllowedRadiusMeters]</p></article>
</section>
<section class="app-panel"><div class="section-heading"><h2>@Localizer["SessionActions"]</h2><p>@Localizer["SessionActionsDescription"]</p></div><div class="row-actions"><form asp-action="RegenerateCode" asp-route-id="@Model.Id" method="post"><button class="btn btn-secondary app-btn" type="submit">@Localizer["RegenerateCode"]</button></form><form asp-action="End" asp-route-id="@Model.Id" method="post"><input name="RowVersion" type="hidden" value="@Model.RowVersion" /><button class="btn btn-primary app-btn" type="submit">@Localizer["EndSession"]</button></form><form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><input name="RowVersion" type="hidden" value="@Model.RowVersion" /><button class="btn btn-danger app-btn" type="submit">@Localizer["CancelSession"]</button></form></div></section>
