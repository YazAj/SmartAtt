@model IReadOnlyList<InstructorScheduleItemDto>
@{
    ViewData["Title"] = Localizer["InstructorScheduleTitle"];
}
<section class="page-header"><div><p class="eyebrow">@Localizer["InstructorRole"]</p><h1>@Localizer["InstructorScheduleTitle"]</h1><p>@Localizer["InstructorScheduleDescription"]</p></div></section>
<section class="app-panel"><div class="timetable-grid">
@foreach (var day in Enum.GetValues<DayOfWeek>())
{
    var dayItems = Model.Where(item => item.DayOfWeek == day).OrderBy(item => item.StartTime).ToList();
    <article class="timetable-day"><h2>@Localizer[$"DayOfWeek{day}"]</h2>@if (dayItems.Count == 0) { <p class="empty-row">@Localizer["NoScheduledLectures"]</p> } else { foreach (var item in dayItems) { <div class="timetable-item"><strong>@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</strong><span>@item.CourseCode - @item.SectionNumber</span><small>@item.ClassroomCode</small><div class="row-actions">@if (item.ActiveSessionId.HasValue) { <a class="btn btn-primary btn-sm" asp-action="Active" asp-route-id="@item.ActiveSessionId.Value">@Localizer["OpenActiveSession"]</a> } else if (item.CanStart) { <form asp-action="Start" asp-route-scheduleId="@item.ScheduleId" method="post"><button class="btn btn-primary btn-sm" type="submit">@Localizer["StartSession"]</button></form> } else { <span class="status-badge">@Localizer["NotEligibleToStart"]</span> }</div></div> } }</article>
}
</div></section>
