@model AdminDashboardSummaryDto
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["AdminDashboardTitle"];
}

<section class="page-header">
    <div>
        <p class="eyebrow">@Localizer["AdminRole"]</p>
        <h1>@Localizer["AdminDashboardTitle"]</h1>
        <p>@Localizer["AdminDashboardLead"]</p>
    </div>
</section>

<section class="dashboard-grid">
    <article class="stat-card">
        <span>@Localizer["StudentsTitle"]</span>
        <strong>@Model.ActiveStudents</strong>
        <p>@Localizer["ActiveStudentsCount"]</p>
    </article>
    <article class="stat-card">
        <span>@Localizer["InstructorsTitle"]</span>
        <strong>@Model.ActiveInstructors</strong>
        <p>@Localizer["ActiveInstructorsCount"]</p>
    </article>
    <article class="stat-card">
        <span>@Localizer["DepartmentsTitle"]</span>
        <strong>@Model.ActiveDepartments</strong>
        <p>@Localizer["ActiveDepartmentsCount"]</p>
    </article>
    <article class="stat-card">
        <span>@Localizer["CoursesTitle"]</span>
        <strong>@Model.ActiveCourses</strong>
        <p>@Localizer["ActiveCoursesCount"]</p>
    </article>
    <article class="stat-card">
        <span>@Localizer["SectionsTitle"]</span>
        <strong>@Model.ActiveSections</strong>
        <p>@Localizer["ActiveSectionsCount"]</p>
    </article>
    <article class="stat-card">
        <span>@Localizer["ClassroomsTitle"]</span>
        <strong>@Model.ActiveClassrooms</strong>
        <p>@Localizer["ActiveClassroomsCount"]</p>
    </article>
</section>

<section class="app-panel">
    <div class="section-heading">
        <h2>@Localizer["AcademicManagementQuickLinks"]</h2>
        <p>@Localizer["AcademicManagementQuickLinksText"]</p>
    </div>
    <div class="component-showcase">
        <a class="btn btn-primary app-btn" asp-area="Admin" asp-controller="Students" asp-action="Create">@Localizer["CreateStudent"]</a>
        <a class="btn btn-primary app-btn" asp-area="Admin" asp-controller="Instructors" asp-action="Create">@Localizer["CreateInstructor"]</a>
        <a class="btn btn-secondary app-btn" asp-area="Admin" asp-controller="Departments" asp-action="Index">@Localizer["DepartmentsTitle"]</a>
        <a class="btn btn-secondary app-btn" asp-area="Admin" asp-controller="Sections" asp-action="Index">@Localizer["SectionsTitle"]</a>
        <a class="btn btn-secondary app-btn" asp-area="Admin" asp-controller="LectureSchedules" asp-action="Index">@Localizer["LectureSchedulesTitle"]</a>
        <a class="btn btn-secondary app-btn" asp-area="Admin" asp-controller="LectureSessions" asp-action="Index">@Localizer["LectureSessionsTitle"]</a>
    </div>
</section>
