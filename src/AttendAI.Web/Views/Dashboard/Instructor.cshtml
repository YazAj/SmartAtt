@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["InstructorDashboardTitle"];
    var emptyState = new EmptyStateViewModel(Localizer["InstructorEmptyTitle"].Value, Localizer["InstructorEmptyText"].Value);
}

<section class="page-header">
    <div>
        <p class="eyebrow">@Localizer["InstructorRole"]</p>
        <h1>@Localizer["InstructorDashboardTitle"]</h1>
        <p>@Localizer["InstructorDashboardLead"]</p>
    </div>
</section>

<section class="dashboard-grid">
    <article class="stat-card">
        <span>@Localizer["FutureModule"]</span>
        <strong>@Localizer["LectureSessions"]</strong>
        <p>@Localizer["InstructorCardSessions"]</p>
    </article>
    <article class="stat-card">
        <span>@Localizer["FutureModule"]</span>
        <strong>@Localizer["AttendanceReview"]</strong>
        <p>@Localizer["InstructorCardReview"]</p>
    </article>
    <article class="stat-card">
        <span>@Localizer["FoundationArea"]</span>
        <strong>@Localizer["SecureAccount"]</strong>
        <p>@Localizer["InstructorCardAccount"]</p>
    </article>
</section>

<partial name="Components/_EmptyState" model="emptyState" />
